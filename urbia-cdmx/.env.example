# URBIA CDMX — Variables de entorno
# Copia este archivo a .env y ajusta los valores

# ── Servidor ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ENV=development  # development | production

# ── Base de datos ─────────────────────────────────────────────────────────────
# SQLite (desarrollo local)
DB_PATH=backend/data/urbia.db

# PostgreSQL/PostGIS (producción, opcional)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/urbia_cdmx

# ── AWS (opcional — el sistema funciona sin estas variables) ──────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# S3_BUCKET_NAME=urbia-cdmx-data

# ── Datos ─────────────────────────────────────────────────────────────────────
# Cargar datos de demostración al inicio (true | false)
LOAD_DEMO_DATA=true

# ADVERTENCIA: Nunca commitear credenciales reales en este archivo.
